{
  "name": "payload-email-msgraph",
  "version": "0.1.0",
  "description": "Payload Microsoft Graph Email Adapter",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokiwi/payload-email-msgraph.git"
  },
  "license": "MIT",
  "author": "tokiwi SA <contact@tokiwi.ch>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --outDir dist",
    "clean": "rimraf -g {dist,*.tsbuildinfo}",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "devDependencies": {
    "payload": "^3.0.0"
  },
  "peerDependencies": {
    "payload": "^3.0.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "registry": "https://registry.npmjs.org/",
    "types": "./dist/index.d.ts"
  }
}
